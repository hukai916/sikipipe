/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run test/urlpipe -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Limit resources so that this can run on GitHub Actions
    max_cpus   = 4
    max_memory = '8.GB'
    max_time   = '6.h'

    outdir = "./results_h3f3d"
    ref = "/home/kai.hu-umw/pi/nathan.lawson-umw/sikipipe/assets/220804_h3f3dTarget_preciseInsert.fa"
    ref2 = "/home/kai.hu-umw/pi/nathan.lawson-umw/sikipipe/assets/220804_h3f3dTarget_WT.fa"

    guide_bed = "/home/kai.hu-umw/pi/nathan.lawson-umw/sikipipe/assets/h3f3dTarget_preciseInsert.bed"
    guide_bed2 = "/home/kai.hu-umw/pi/nathan.lawson-umw/sikipipe/assets/h3f3dTarget_WT.bed"


    input  = "sample_sheet/sci/h3f3d.csv"
    insert_fasta = "/home/kai.hu-umw/pi/nathan.lawson-umw/sikipipe/assets/avitagHingeMyc.fas"

}
